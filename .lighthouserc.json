{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes http-server -p 8080 -s .",
      "startServerReadyPattern": "port 8080",
      "url": [
        "http://localhost:8080/index.html",
        "http://localhost:8080/enciclopedia.html",
        "http://localhost:8080/videoteca.html",
        "http://localhost:8080/enlaces.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "preset": "desktop",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "categories:accessibility": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "categories:best-practices": ["warn", { "minScore": 0.7 }],
        "is-on-https": "off",
        "canonical": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
